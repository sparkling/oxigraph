      "operation": "sparql-select",
      "classification": "agreement",
      "normativeBasis": "https://www.w3.org/TR/sparql12-query/",
      "reviewed": true,
      "data": "@prefix ex: <https://example.test/> . ex:a ex:p 1 . ex:b ex:q 2 .",
      "query": "PREFIX ex: <https://example.test/> SELECT ?s WHERE { { ?s ex:p ?o } UNION { ?s ex:q ?o } }",
      "assertions": [
        {"target": "both", "pointer": "/status", "equals": "success"},
        {"target": "both", "pointer": "/value/row_count", "equals": 2}
