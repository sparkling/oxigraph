      "reviewed": true,
      "data": "@prefix ex: <https://example.test/> . ex:s ex:p ex:o .",
      "query": "PREFIX ex: <https://example.test/> ASK { ex:s ex:missing ?o }",
      "assertions": [
        {"target": "both", "pointer": "/status", "equals": "success"},
        {"target": "both", "pointer": "/value", "equals": false}
      ]
    },
