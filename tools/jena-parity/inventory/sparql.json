      "classification": "agreement",
      "normativeBasis": "https://www.w3.org/TR/sparql12-update/",
      "reviewed": true,
      "data": "@prefix ex: <https://example.test/> . ex:s ex:old \"value\" .",
      "update": "PREFIX ex: <https://example.test/> DELETE { ex:s ex:old ?v } INSERT { ex:s ex:new ?v } WHERE { ex:s ex:old ?v }",
      "assertions": [
        {"target": "both", "pointer": "/status", "equals": "success"},
        {"target": "both", "pointer": "/value/quad_count", "equals": 1}
      ]
    },
