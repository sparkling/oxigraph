    {
      "id": "sparql-invalid-query",
      "domain": "sparql",
      "operation": "sparql-select",
      "classification": "agreement",
      "normativeBasis": "https://www.w3.org/TR/sparql12-query/",
      "reviewed": true,
      "query": "SELECT WHERE {",
      "assertions": [
        {"target": "both", "pointer": "/status", "equals": "error"},
        {"target": "both", "pointer": "/error_code", "equals": "syntax-or-evaluation"}
      ]
    },
    {
      "id": "sparql-jena-afn-localname",
      "domain": "sparql",
      "operation": "sparql-select",
      "classification": "jena-extension",
      "normativeBasis": "https://jena.apache.org/documentation/query/library-function.html",
      "reviewed": true,
      "syntax": "arq",
      "query": "PREFIX afn: <http://jena.apache.org/ARQ/function#> SELECT (afn:localname(<https://example.test/resource>) AS ?name) WHERE {}",
      "assertions": [
        {"target": "jena", "pointer": "/status", "equals": "success"},
        {"target": "jena", "pointer": "/value/row_count", "equals": 1},
        {"target": "oxigraph", "pointer": "/status", "equals": "error"}
      ]
    },
    {
      "id": "sparql-named-graph",
      "domain": "sparql",
      "operation": "sparql-select",
      "classification": "agreement",
      "normativeBasis": "https://www.w3.org/TR/sparql12-query/",
      "reviewed": true,
      "syntax": "trig",
      "data": "@prefix ex: <https://example.test/> . ex:g { ex:s ex:p ex:o }",
      "query": "PREFIX ex: <https://example.test/> SELECT ?g ?o WHERE { GRAPH ?g { ex:s ex:p ?o } }",
      "assertions": [
        {"target": "both", "pointer": "/status", "equals": "success"},
        {"target": "both", "pointer": "/value/row_count", "equals": 1}
      ]
    },
    {
      "id": "sparql-select-empty-named-graph",
      "domain": "sparql",
      "operation": "sparql-select",
      "classification": "w3c-overrides-jena",
      "normativeBasis": "https://www.w3.org/TR/sparql12-query/#accessByIdentifier",
      "reviewed": true,
      "syntax": "trig",
      "ordered": true,
      "data": "<urn:g> {}",
      "query": "SELECT ?g WHERE { GRAPH ?g {} }",
      "assertions": [
        {"target": "jena", "pointer": "/status", "equals": "success"},
        {"target": "jena", "pointer": "/value/variables", "equals": ["g"]},
        {"target": "jena", "pointer": "/value/row_count", "equals": 0},
        {"target": "jena", "pointer": "/value/rows", "equals": []},
        {"target": "oxigraph", "pointer": "/status", "equals": "success"},
        {"target": "oxigraph", "pointer": "/value/variables", "equals": ["g"]},
        {"target": "oxigraph", "pointer": "/value/row_count", "equals": 1},
        {
          "target": "oxigraph",
          "pointer": "/value/rows",
          "equals": [{"g": {"type": "iri", "value": "urn:g"}}]
        }
      ]
    },
    {
      "id": "sparql-optional",
      "domain": "sparql",
      "operation": "sparql-select",
      "classification": "agreement",
      "normativeBasis": "https://www.w3.org/TR/sparql12-query/",
      "reviewed": true,
      "data": "@prefix ex: <https://example.test/> . ex:a ex:p 1; ex:q 2 . ex:b ex:p 3 .",
      "query": "PREFIX ex: <https://example.test/> SELECT ?s ?q WHERE { ?s ex:p ?p OPTIONAL { ?s ex:q ?q } }",
      "assertions": [
        {"target": "both", "pointer": "/status", "equals": "success"},
        {"target": "both", "pointer": "/value/row_count", "equals": 2}
      ]
    },
    {
      "id": "sparql-order-by",
