    {
      "id": "sparql-subquery",
      "domain": "sparql",
      "operation": "sparql-select",
      "classification": "agreement",
      "normativeBasis": "https://www.w3.org/TR/sparql12-query/",
      "reviewed": true,
      "data": "@prefix ex: <https://example.test/> . ex:a ex:value 2 . ex:b ex:value 1 .",
      "query": "PREFIX ex: <https://example.test/> SELECT ?s WHERE { { SELECT ?s WHERE { ?s ex:value ?v } ORDER BY ?v LIMIT 1 } }",
      "assertions": [
        {"target": "both", "pointer": "/status", "equals": "success"},
        {"target": "both", "pointer": "/value/row_count", "equals": 1}
