{
  "scenarios": [
    {
      "id": "sparql-aggregate-count",
      "domain": "sparql",
      "operation": "sparql-select",
      "classification": "agreement",
      "normativeBasis": "https://www.w3.org/TR/sparql12-query/",
      "reviewed": true,
      "data": "@prefix ex: <https://example.test/> . ex:s ex:p 1, 2, 3 .",
      "query": "PREFIX ex: <https://example.test/> SELECT (COUNT(?o) AS ?count) WHERE { ex:s ex:p ?o }",
      "assertions": [
        {"target": "both", "pointer": "/status", "equals": "success"},
        {"target": "both", "pointer": "/value/row_count", "equals": 1}
      ]
    },
    {
      "id": "sparql-aggregate-group-sum",
      "domain": "sparql",
      "operation": "sparql-select",
      "classification": "agreement",
      "normativeBasis": "https://www.w3.org/TR/sparql12-query/",
      "reviewed": true,
      "data": "@prefix ex: <https://example.test/> . ex:a ex:group \"x\"; ex:value 1 . ex:b ex:group \"x\"; ex:value 2 .",
      "query": "PREFIX ex: <https://example.test/> SELECT ?group (SUM(?value) AS ?sum) WHERE { ?s ex:group ?group; ex:value ?value } GROUP BY ?group",
      "assertions": [
        {"target": "both", "pointer": "/status", "equals": "success"},
        {"target": "both", "pointer": "/value/row_count", "equals": 1}
      ]
    },
