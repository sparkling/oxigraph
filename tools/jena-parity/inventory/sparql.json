      "query": "SELECT ?value WHERE { BIND(2 + 3 AS ?value) }",
      "assertions": [
        {"target": "both", "pointer": "/status", "equals": "success"},
        {"target": "both", "pointer": "/value/row_count", "equals": 1}
      ]
    },
    {
      "id": "sparql-construct-basic",
      "domain": "sparql",
      "operation": "sparql-construct",
      "classification": "agreement",
      "normativeBasis": "https://www.w3.org/TR/sparql12-query/",
      "reviewed": true,
      "data": "@prefix ex: <https://example.test/> . ex:s ex:p ex:o .",
      "query": "PREFIX ex: <https://example.test/> CONSTRUCT { ?s ex:q ?o } WHERE { ?s ex:p ?o }",
      "assertions": [
        {"target": "both", "pointer": "/status", "equals": "success"},
        {"target": "both", "pointer": "/value/quad_count", "equals": 1}
