      "reviewed": true,
      "data": "@prefix ex: <https://example.test/> . ex:a ex:p \"same\" . ex:b ex:p \"same\" .",
      "query": "PREFIX ex: <https://example.test/> SELECT DISTINCT ?o WHERE { ?s ex:p ?o }",
      "assertions": [
        {"target": "both", "pointer": "/status", "equals": "success"},
        {"target": "both", "pointer": "/value/row_count", "equals": 1}
      ]
    },
    {
      "id": "sparql-filter-numeric",
      "domain": "sparql",
      "operation": "sparql-select",
      "classification": "agreement",
      "normativeBasis": "https://www.w3.org/TR/sparql12-query/",
      "reviewed": true,
      "data": "@prefix ex: <https://example.test/> . ex:a ex:value 1 . ex:b ex:value 3 .",
      "query": "PREFIX ex: <https://example.test/> SELECT ?s WHERE { ?s ex:value ?v FILTER(?v > 1) }",
      "assertions": [
        {"target": "both", "pointer": "/status", "equals": "success"},
        {"target": "both", "pointer": "/value/row_count", "equals": 1}
