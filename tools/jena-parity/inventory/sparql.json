      "operation": "sparql-select",
      "classification": "agreement",
      "normativeBasis": "https://www.w3.org/TR/sparql12-query/",
      "reviewed": true,
      "ordered": true,
      "data": "@prefix ex: <https://example.test/> . ex:s ex:p 3, 1, 2 .",
      "query": "PREFIX ex: <https://example.test/> SELECT ?value WHERE { ex:s ex:p ?value } ORDER BY ?value",
      "assertions": [
        {"target": "both", "pointer": "/status", "equals": "success"},
        {"target": "both", "pointer": "/value/row_count", "equals": 3}
      ]
    },
    {
      "id": "sparql-path-alternative",
