    },
    {
      "id": "sparql-describe-basic",
      "domain": "sparql",
      "operation": "sparql-describe",
      "classification": "agreement",
      "normativeBasis": "https://www.w3.org/TR/sparql12-query/",
      "reviewed": true,
      "data": "@prefix ex: <https://example.test/> . ex:s ex:p ex:o . ex:o ex:q \"not described\" . ex:other ex:p ex:s .",
      "query": "DESCRIBE <https://example.test/s>",
      "assertions": [
        {"target": "both", "pointer": "/status", "equals": "success"},
        {"target": "both", "pointer": "/kind", "equals": "dataset"},
        {"target": "both", "pointer": "/value/quad_count", "equals": 1},
        {"target": "both", "pointer": "/value/quads/0/0/value", "equals": "https://example.test/s"}
      ]
    },
    {
      "id": "sparql-service-offline-handler",
      "domain": "sparql",
      "operation": "sparql-service",
      "classification": "agreement",
      "normativeBasis": "https://www.w3.org/TR/sparql12-federated-query/",
      "reviewed": true,
      "query": "SELECT ?remote WHERE { SERVICE <urn:oxigraph:jena-parity:service> { BIND(\"remote graph pattern\" AS ?remote) } }",
      "assertions": [
        {"target": "both", "pointer": "/status", "equals": "success"},
        {"target": "both", "pointer": "/kind", "equals": "solutions"},
        {"target": "both", "pointer": "/value/row_count", "equals": 1},
        {"target": "both", "pointer": "/value/rows/0/remote/value", "equals": "offline-service"}
      ]
    },
    {
      "id": "sparql-update-clear-graph",
      "domain": "sparql",
      "operation": "sparql-update",
      "classification": "w3c-permitted-divergence",
      "normativeBasis": "https://www.w3.org/TR/sparql12-update/#clear",
      "reviewed": true,
      "syntax": "trig",
      "data": "@prefix ex: <https://example.test/> . ex:g { ex:s ex:p ex:o }",
      "update": "PREFIX ex: <https://example.test/> CLEAR GRAPH ex:g",
      "assertions": [
        {"target": "jena", "pointer": "/status", "equals": "success"},
        {"target": "jena", "pointer": "/value/quad_count", "equals": 0},
        {"target": "jena", "pointer": "/value/named_graph_count", "equals": 0},
        {"target": "jena", "pointer": "/value/named_graphs", "equals": []},
        {"target": "oxigraph", "pointer": "/status", "equals": "success"},
        {"target": "oxigraph", "pointer": "/value/quad_count", "equals": 0},
        {"target": "oxigraph", "pointer": "/value/named_graph_count", "equals": 1},
        {
          "target": "oxigraph",
          "pointer": "/value/named_graphs",
          "equals": [{"type": "iri", "value": "https://example.test/g"}]
        }
      ]
    },
    {
