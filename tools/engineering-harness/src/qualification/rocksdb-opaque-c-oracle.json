  "lifecycle": [
    {
      "id": "read-options",
      "contract": "created only by the public constructor, reconstructed from product-owned async/snapshot state rather than copied as an opaque object, and destroyed exactly once"
    },
    {
      "id": "bounds",
      "contract": "the Rust-owned lower/upper-bound bytes outlive the read options and iterator that borrow them; iterator destruction precedes read-options destruction"
    },
    {
      "id": "snapshot",
      "contract": "the DB outlives its snapshot, every read option borrowing a snapshot is destroyed before that snapshot is released, and release occurs exactly once"
    },
    {
      "id": "iterator",
      "contract": "iterator key/value slices are borrowed only until movement or destruction; the iterator is destroyed exactly once before its read options and bound owner"
    },
    {
      "id": "transaction-overlay",
      "contract": "reads and iterators use the public WriteBatchWithIndex overlay APIs; the overlay outlives its readers and is destroyed before read options and snapshot release"
    },
    {
      "id": "pinned-and-buffer-getters",
      "contract": "not-found remains distinct from error and short-buffer; borrowed bytes never outlive their public pin handle, which is destroyed exactly once on every terminal path"
    },
    {
      "id": "multi-cf-ingest",
      "contract": "all column-family arguments and path storage outlive one and only one DB::IngestExternalFiles call so validation failure cannot degrade into per-CF partial ingestion"
    }
  ]
