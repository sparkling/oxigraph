  "requiredExtension": {
    "symbol": "oxrocksdb_ingest_external_files",
    "reason": "the public C API exposes only per-column-family ingestion and cannot preserve one atomic DB::IngestExternalFiles call across column families",
    "ownerTranslationUnit": "oxrocksdb-sys/rocksdb/db/c.cc",
    "forbiddenTranslationUnit": "oxrocksdb-sys/api/c.cc",
    "header": "oxrocksdb-sys/api/c.h",
    "rustCallSite": "lib/oxigraph/src/storage/rocksdb_wrapper.rs",
    "atomicCppCall": "IngestExternalFiles",
    "ownership": "copy every path into storage that outlives argument assembly, bind each public opaque CF/options object only inside the upstream-owned translation unit, invoke DB::IngestExternalFiles exactly once, and report one status",
    "candidateOverlay": {
      "placement": "exact-append-to-pristine-db-c-cc",
      "changedPaths": ["db/c.cc"],
      "utf8": "\nstruct rocksdb_ingestexternalfilearg_t {\n  rocksdb_column_family_handle_t* column_family;\n  const char* const* external_files;\n  size_t external_files_len;\n  rocksdb_ingestexternalfileoptions_t* options;\n};\n\nextern \"C\" void oxrocksdb_ingest_external_files(\n    rocksdb_t* db, const rocksdb_ingestexternalfilearg_t* list,\n    const size_t list_len, char** errptr) {\n  vector<rocksdb::IngestExternalFileArg> args(list_len);\n  for (size_t i = 0; i < list_len; ++i) {\n    args[i].column_family = list[i].column_family->rep;\n    for (size_t j = 0; j < list[i].external_files_len; ++j) {\n      args[i].external_files.emplace_back(list[i].external_files[j]);\n    }\n    args[i].options = list[i].options->rep;\n  }\n  SaveError(errptr, db->rep->IngestExternalFiles(args));\n}\n",
      "sha256": "94b61090379d7f0717c9955f43fb218a86a83da1c0c16b7497f1d8c13374a1f6",
      "resultSha256": "a501913889fcc828581ca37853baf1af5834e7af0ab02af7fd37976f3c727526"
    }
  },
