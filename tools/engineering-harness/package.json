{
  "name": "@oxigraph/engineering-harness",
  "private": true,
  "version": "0.0.0",
  "description": "Local-only native-provider engineering harness for the Oxigraph linked-data programme",
  "type": "module",
  "bin": {
    "oxigraph-engineering-harness": "bin/oxigraph-engineering-harness.mjs"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "doctor": "node bin/oxigraph-engineering-harness.mjs doctor",
    "g1.2:preflight": "node bin/oxigraph-engineering-harness.mjs g1.2 preflight",
    "g1.2:run": "node bin/oxigraph-engineering-harness.mjs g1.2 run",
    "g1.3:preflight": "node bin/oxigraph-engineering-harness.mjs g1.3 preflight",
    "g1.3:run": "node bin/oxigraph-engineering-harness.mjs g1.3 run",
    "g1.4:preflight": "node bin/oxigraph-engineering-harness.mjs g1.4 preflight",
    "g1.4:run": "node bin/oxigraph-engineering-harness.mjs g1.4 run",
    "g1.5:preflight": "node bin/oxigraph-engineering-harness.mjs g1.5 preflight",
    "g1.5:run": "node bin/oxigraph-engineering-harness.mjs g1.5 run",
    "g1.5b:preflight": "node bin/oxigraph-engineering-harness.mjs g1.5b preflight",
    "g1.5b:run": "node bin/oxigraph-engineering-harness.mjs g1.5b run",
    "g1.5c:preflight": "node bin/oxigraph-engineering-harness.mjs g1.5c preflight",
    "g1.5c:run": "node bin/oxigraph-engineering-harness.mjs g1.5c run",
    "g1.6:preflight": "node bin/oxigraph-engineering-harness.mjs g1.6 preflight",
    "g1.6:run": "node bin/oxigraph-engineering-harness.mjs g1.6 run",
    "g1.7:preflight": "node bin/oxigraph-g1.7-qualification.mjs preflight",
    "g1.7:run": "node bin/oxigraph-g1.7-qualification.mjs run",
    "g1.7:verify": "node bin/oxigraph-g1.7-qualification.mjs verify",
    "factory:diagnose": "node bin/oxigraph-engineering-harness.mjs factory diagnose"
  },
  "dependencies": {
    "@metaharness/avo": "latest",
    "@metaharness/darwin": "latest",
    "@metaharness/harness": "latest",
    "@metaharness/router": "latest",
    "metaharness": "latest"
  },
  "engines": {
    "node": ">=20"
  }
}
