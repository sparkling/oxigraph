{
    "name": "oxigraph_tests",
    "description": "Oxigraph JS build and tests",
    "private": true,
    "dependencies": {
        "@rdfjs/data-model": "latest",
        "@rdfjs/types": "latest"
    },
    "devDependencies": {
        "@biomejs/biome": "latest",
        "@codspeed/vitest-plugin": "latest",
        "@tsconfig/node18": "latest",
        "@tsconfig/strictest": "latest",
        "@types/node": "latest",
        "@types/rdfjs__data-model": "latest",
        "fzstd": "latest",
        "typescript": "latest",
        "vitest": "latest",
        "vite-plugin-wasm": "latest"
    },
    "scripts": {
        "fmt": "biome check --write --unsafe .",
        "test": "npm run build-debug && vitest",
        "build": "python build_package.py",
        "build-debug": "python build_package.py --debug",
        "release": "npm run build && npm publish --provenance --access public ./pkg",
        "pack": "npm run build && npm pack ./pkg",
        "bench": "npm run build && vitest bench"
    }
}
